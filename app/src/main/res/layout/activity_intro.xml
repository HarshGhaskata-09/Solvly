<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/introRootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- Top gradient decoration -->
    <View
        android:id="@+id/topGradientDecor"
        android:layout_width="320dp"
        android:layout_height="320dp"
        android:background="@drawable/intro_gradient_circle"
        android:alpha="0.12"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="-80dp"/>

    <!-- Center content group -->
    <LinearLayout
        android:id="@+id/contentCenter"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingHorizontal="36dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomCard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- App Icon Container -->
        <LinearLayout
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:background="@drawable/intro_icon_bg"
            android:gravity="center"
            android:elevation="6dp"
            android:layout_gravity="center">

            <ImageView
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:src="@mipmap/ic_launcher"
                android:scaleType="fitCenter" />
        </LinearLayout>

        <!-- App Name -->
        <TextView
            android:id="@+id/textAppName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/intro_app_name"
            android:textSize="40sp"
            android:textStyle="bold"
            android:textColor="#1E293B"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="-0.02" />

        <!-- Tagline -->
        <TextView
            android:id="@+id/textTagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/intro_tagline"
            android:textSize="16sp"
            android:textColor="#6366F1"
            android:fontFamily="sans-serif"
            android:letterSpacing="0.02"/>

        <!-- Description -->
        <TextView
            android:id="@+id/textDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/intro_description"
            android:textSize="15sp"
            android:textColor="#64748B"
            android:lineSpacingMultiplier="1.5"
            android:gravity="center"
            android:fontFamily="sans-serif"/>

        <!-- Feature pills row -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:orientation="horizontal"
            android:gravity="center">

            <!-- Pill 1 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/intro_pill_bg"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp"
                android:paddingVertical="7dp"
                android:gravity="center_vertical"
                android:layout_marginEnd="8dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/intro_feature_camera"
                    android:textSize="13sp"
                    android:textColor="#4F46E5"
                    android:fontFamily="sans-serif-medium"/>
            </LinearLayout>

            <!-- Pill 2 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/intro_pill_bg"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp"
                android:paddingVertical="7dp"
                android:gravity="center_vertical"
                android:layout_marginEnd="8dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/intro_feature_ai_solve"
                    android:textSize="13sp"
                    android:textColor="#4F46E5"
                    android:fontFamily="sans-serif-medium"/>
            </LinearLayout>

            <!-- Pill 3 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/intro_pill_bg"
                android:paddingHorizontal="14dp"
                android:paddingVertical="7dp"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/intro_feature_history"
                    android:textSize="13sp"
                    android:textColor="#4F46E5"
                    android:fontFamily="sans-serif-medium"/>
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

    <!-- Bottom card with policy checkbox and button -->
    <LinearLayout
        android:id="@+id/bottomCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/intro_bottom_card_bg"
        android:paddingHorizontal="24dp"
        android:paddingTop="24dp"
        android:paddingBottom="32dp"
        android:elevation="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Policy checkbox row -->
        <LinearLayout
            android:id="@+id/policyCheckRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="4dp">

            <CheckBox
                android:id="@+id/checkBoxPolicy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="#6366F1"
                android:scaleX="1.1"
                android:scaleY="1.1"/>

            <TextView
                android:id="@+id/textPolicyLink"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:text="@string/intro_privacy_agree"
                android:textSize="14sp"
                android:textColor="#475569"
                android:fontFamily="sans-serif"
                android:lineSpacingMultiplier="1.3"/>
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#F1F5F9"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"/>

        <!-- Continue Button -->
        <Button
            android:id="@+id/buttonContinue"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/intro_get_started"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.02"
            android:background="@drawable/intro_button_disabled_bg"
            android:enabled="false"
            android:stateListAnimator="@null"
            android:elevation="0dp"/>

        <!-- Version note -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="14dp"
            android:text="@string/intro_terms_footer"
            android:textSize="11sp"
            android:textColor="#94A3B8"
            android:gravity="center"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>